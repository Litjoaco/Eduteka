# ==========================================
# EDUTEKA - Plantilla de Variables de Entorno (.env.example)
# ==========================================
# Copia este archivo como '.env' en la raíz y define tus valores locales.
# NUNCA subas el archivo '.env' real a Git.

# Configuración Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Configuración Base de Datos MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=edutekadb
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
